generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Tier {
  PIXEL
  GRID
  MARK
}

enum Collection {
  STANDARD
  BOOT
  RARE
  CUSTOM
}

enum Finish {
  GLOSS
  MATTE
}

enum DiscountType {
  FLAT
  PERCENT
  FREE_DELIVERY
  FIXED_PRICE_1RS
  TOTAL_BILL_1RS
  FREE_ORDER
}

enum SecretUnlock {
  RARE_SECTION
  SHADOW_DROP
}

enum RequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

// Models
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String?
  name                  String?
  dott_handle           String?   @unique
  avatar_url            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  tier                  Tier      @default(PIXEL)
  role                  String    @default("USER")
  total_orders          Int       @default(0)
  total_stickers_bought Int       @default(0)
  points                Int       @default(0)
  progress_to_next_tier Float     @default(0.0)

  badges                String[]
  secret_unlocked       Boolean   @default(false)
  rare_unlocked         Boolean   @default(false)
  boot_access           Boolean   @default(false)
  
  orders                Order[]
  custom_requests       CustomStickerRequest[]
  
  // NextAuth related
  emailVerified         DateTime?
  image                 String?
  accounts              Account[]
  sessions              Session[]
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Sticker {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  image_url   String
  collection  Collection @default(STANDARD)
  drop_number Int        @default(1)
  price       Int        // in paise
  stock       Int        @default(0)
  sold        Int        @default(0)
  is_active   Boolean    @default(true)
  is_locked   Boolean    @default(false)
  tags        String[]
  size        String?
  finish      Finish     @default(GLOSS)
  slot_number Int?
  
  order_items           OrderItem[]
  restock_notifications RestockNotification[]
}

model Order {
  id                  String      @id @default(cuid())
  user_id             String
  order_number        String      @unique // DOTT-XXXXXX
  subtotal            Int
  discount_amount     Int         @default(0)
  delivery_charge     Int         @default(0)
  total               Int
  payment_status      String      @default("PENDING") // PENDING, COMPLETED, FAILED
  razorpay_order_id   String?     @unique
  razorpay_payment_id String?     @unique
  delivery_address    Json?
  promo_code_used     String?
  invoice_url         String?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  
  user                User        @relation(fields: [user_id], references: [id])
  items               OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  order_id   String
  sticker_id String
  quantity   Int     @default(1)
  price      Int     // price at time of purchase
  
  order      Order   @relation(fields: [order_id], references: [id])
  sticker    Sticker @relation(fields: [sticker_id], references: [id])
}

model PromoCode {
  id             String       @id @default(cuid())
  code           String       @unique
  discount_type  DiscountType
  discount_value Int
  max_uses       Int?
  used_count     Int          @default(0)
  expires_at     DateTime?
  is_active      Boolean      @default(true)
}

model SecretCode {
  id         String       @id @default(cuid())
  code       String       @unique
  unlocks    SecretUnlock
  used_by    String[]     // array of user_ids
  max_uses   Int?
}

model CustomStickerRequest {
  id         String        @id @default(cuid())
  user_id    String
  image_url  String
  status     RequestStatus @default(PENDING)
  notes      String?       @db.Text
  created_at DateTime      @default(now())
  
  user       User          @relation(fields: [user_id], references: [id])
}

model RestockNotification {
  id         String   @id @default(cuid())
  email      String
  sticker_id String
  created_at DateTime @default(now())

  sticker    Sticker  @relation(fields: [sticker_id], references: [id])

  @@unique([email, sticker_id])
}

model RateLimit {
  id         String   @id @default(cuid())
  ip         String
  endpoint   String
  count      Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ip, endpoint])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}
